{
  "uid": "monitoreo-lineas",
  "title": "Monitoreo de lineas de envasado",
  "tags": [
    "bi-vinilos",
    "monitoreo"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Estado casi en tiempo real de las lineas Vinilos_1 a Vinilos_4: produccion, paros y alerta.",
  "templating": {
    "list": [
      {
        "name": "maquina",
        "label": "Maquina",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "bi-vinilos-pg"
        },
        "query": "SELECT nombre FROM dw.dim_maquina WHERE maquina_key > 0 ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": null,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "turno",
        "label": "Turno",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "bi-vinilos-pg"
        },
        "query": "SELECT nombre FROM dw.dim_turno WHERE turno_key > 0 ORDER BY turno_key",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": null,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Estado actual por maquina",
      "description": "Ultima lectura de cada maquina. PARADA = mas de 30 min de paro en la hora (umbral de la alerta).",
      "datasource": {
        "type": "postgres",
        "uid": "bi-vinilos-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "bi-vinilos-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT r.fecha_hora AS time, m.nombre AS metric, r.minutos_paro AS value\nFROM dw.fact_registro_horario r\nJOIN dw.dim_maquina m USING (maquina_key)\nJOIN dw.dim_turno t USING (turno_key)\nJOIN dw.dim_meta_velocidad mv USING (meta_key)\nWHERE $__timeFilter(r.fecha_hora) AND m.nombre IN ($maquina) AND t.nombre IN ($turno)\nORDER BY 1"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 30.01
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0.009,
                "result": {
                  "text": "Produciendo",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.01,
                "to": 30,
                "result": {
                  "text": "Paro corto",
                  "color": "orange",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 30.01,
                "to": 100,
                "result": {
                  "text": "PARADA",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "alertlist",
      "title": "Alertas",
      "datasource": {
        "type": "postgres",
        "uid": "bi-vinilos-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 10,
        "sortOrder": 1,
        "showInstances": true,
        "alertInstanceLabelFilter": "",
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": false,
          "normal": true,
          "error": true
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pacas por lectura (hora)",
      "description": "Produccion de cada lectura. Cada lectura representa una hora de produccion.",
      "datasource": {
        "type": "postgres",
        "uid": "bi-vinilos-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "bi-vinilos-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT r.fecha_hora AS time, m.nombre AS metric, r.pacas_hora AS value\nFROM dw.fact_registro_horario r\nJOIN dw.dim_maquina m USING (maquina_key)\nJOIN dw.dim_turno t USING (turno_key)\nJOIN dw.dim_meta_velocidad mv USING (meta_key)\nWHERE $__timeFilter(r.fecha_hora) AND m.nombre IN ($maquina) AND t.nombre IN ($turno)\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Minutos de paro por lectura (umbral de alerta: 30)",
      "description": "La linea roja punteada es el umbral de la alerta: mas de 30 min en 2 lecturas seguidas.",
      "datasource": {
        "type": "postgres",
        "uid": "bi-vinilos-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "bi-vinilos-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT r.fecha_hora AS time, m.nombre AS metric, r.minutos_paro AS value\nFROM dw.fact_registro_horario r\nJOIN dw.dim_maquina m USING (maquina_key)\nJOIN dw.dim_turno t USING (turno_key)\nJOIN dw.dim_meta_velocidad mv USING (meta_key)\nWHERE $__timeFilter(r.fecha_hora) AND m.nombre IN ($maquina) AND t.nombre IN ($turno)\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "min": 0,
          "max": 60,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Disponibilidad del periodo",
      "description": "1 - minutos de paro / minutos programados en el rango de tiempo elegido.",
      "datasource": {
        "type": "postgres",
        "uid": "bi-vinilos-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "bi-vinilos-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT m.nombre AS metric, 1 - sum(r.minutos_paro) / (60.0 * count(*)) AS value\nFROM dw.fact_registro_horario r\nJOIN dw.dim_maquina m USING (maquina_key)\nJOIN dw.dim_turno t USING (turno_key)\nJOIN dw.dim_meta_velocidad mv USING (meta_key)\nWHERE $__timeFilter(r.fecha_hora) AND m.nombre IN ($maquina) AND t.nombre IN ($turno)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^value$/"
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Rendimiento frente a la meta",
      "description": "Pacas producidas / pacas esperadas segun la velocidad de referencia de la maquina.",
      "datasource": {
        "type": "postgres",
        "uid": "bi-vinilos-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "bi-vinilos-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT m.nombre AS metric, sum(r.pacas_hora) / nullif(sum(mv.pacas_por_hora * (60 - r.minutos_paro) / 60.0), 0) AS value\nFROM dw.fact_registro_horario r\nJOIN dw.dim_maquina m USING (maquina_key)\nJOIN dw.dim_turno t USING (turno_key)\nJOIN dw.dim_meta_velocidad mv USING (meta_key)\nWHERE $__timeFilter(r.fecha_hora) AND m.nombre IN ($maquina) AND t.nombre IN ($turno)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^value$/"
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1.2,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Horas de paro por causa",
      "description": "Causas de paro en el rango de tiempo elegido.",
      "datasource": {
        "type": "postgres",
        "uid": "bi-vinilos-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "bi-vinilos-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT p.nombre_codigo AS metric, sum(r.minutos_paro) / 60.0 AS value\nFROM dw.fact_registro_horario r\nJOIN dw.dim_maquina m USING (maquina_key) JOIN dw.dim_turno t USING (turno_key) JOIN dw.dim_paro p USING (paro_key)\nWHERE $__timeFilter(r.fecha_hora) AND m.nombre IN ($maquina) AND t.nombre IN ($turno) AND r.paro_key <> -1\nGROUP BY 1 ORDER BY 2 DESC LIMIT 8"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^value$/"
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 2,
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Ultimas lecturas",
      "description": "Detalle de las lecturas mas recientes, con la causa del paro.",
      "datasource": {
        "type": "postgres",
        "uid": "bi-vinilos-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "bi-vinilos-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT r.fecha_hora AS \"Hora (UTC)\", m.nombre AS \"Maquina\", t.nombre AS \"Turno\", rf.nombre_estandar AS \"Referencia\",\n       r.pacas_hora AS \"Pacas\", r.minutos_paro AS \"Min. paro\", p.nombre_codigo AS \"Causa\"\nFROM dw.fact_registro_horario r\nJOIN dw.dim_maquina m USING (maquina_key) JOIN dw.dim_turno t USING (turno_key)\nJOIN dw.dim_referencia rf USING (referencia_key) JOIN dw.dim_paro p USING (paro_key)\nWHERE $__timeFilter(r.fecha_hora) AND m.nombre IN ($maquina) AND t.nombre IN ($turno)\nORDER BY r.fecha_hora DESC, m.nombre LIMIT 20"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Min. paro"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.01
                    },
                    {
                      "color": "red",
                      "value": 30.01
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  ]
