{
  "name": "BI Vinilos minimalista",
  "dataColors": [
    "#0F766E",
    "#2563EB",
    "#D97706",
    "#7C3AED",
    "#0EA5E9",
    "#94A3B8",
    "#16A34A",
    "#DC2626"
  ],
  "background": "#FFFFFF",
  "foreground": "#0F172A",
  "tableAccent": "#0F766E",
  "good": "#16A34A",
  "neutral": "#D97706",
  "bad": "#DC2626",
  "maximum": "#0F766E",
  "center": "#CBD5E1",
  "minimum": "#F1F5F9",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#64748B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#64748B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F9"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold",
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontSize": 11,
            "fontFamily": "Segoe UI",
            "color": {
              "solid": {
                "color": "#64748B"
              }
            }
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": false
          }
        ],
        "items": [
          {
            "fontSize": 11,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            }
          }
        ],
        "data": [
          {
            "mode": "Dropdown"
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "showAxisTitle": false,
            "lineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#EEF2F6"
              }
            }
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 2.25,
            "showMarker": false
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#64748B"
              }
            }
          }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#EEF2F6"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "fontSize": 11,
            "fontColorPrimary": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEF2F6"
              }
            },
            "rowPadding": 6
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "values": [
          {
            "fontSize": 11,
            "fontColorPrimary": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEF2F6"
              }
            },
            "rowPadding": 6
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "fill": [
          {
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          },
          {
            "$id": "selected",
            "fillColor": {
              "solid": {
                "color": "#0F766E"
              }
            },
            "transparency": 0
          }
        ],
        "text": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#64748B"
              }
            }
          },
          {
            "$id": "selected",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "outline": [
          {
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "weight": 1
          },
          {
            "$id": "selected",
            "lineColor": {
              "solid": {
                "color": "#0F766E"
              }
            }
          }
        ]
      }
    }
  }
}