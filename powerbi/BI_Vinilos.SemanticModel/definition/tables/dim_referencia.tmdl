table dim_referencia

	column referencia_key
		dataType: int64
		isHidden
		formatString: 0
		sourceColumn: referencia_key
		summarizeBy: none

	column nombre_estandar
		dataType: string
		sourceColumn: nombre_estandar
		summarizeBy: none

	column producto
		dataType: string
		sourceColumn: producto
		summarizeBy: none

	column contenido_cc
		dataType: int64
		formatString: 0
		sourceColumn: contenido_cc
		summarizeBy: none

	column num_colores
		dataType: int64
		formatString: 0
		sourceColumn: num_colores
		summarizeBy: none

	partition dim_referencia = m
		mode: import
		source =
			let
			    Origen = PostgreSQL.Database(Servidor, BaseDatos),
			    Tabla = Origen{[Schema = "dw", Item = "dim_referencia"]}[Data],
			    Tipos = Table.TransformColumnTypes(Tabla, {{"referencia_key", Int64.Type}, {"nombre_estandar", type text}, {"producto", type text}, {"contenido_cc", Int64.Type}, {"num_colores", Int64.Type}})
			in
			    Tipos
