table dim_fecha
	dataCategory: Time

	column fecha_key
		dataType: int64
		isHidden
		formatString: 0
		sourceColumn: fecha_key
		summarizeBy: none

	column fecha
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		sourceColumn: fecha
		summarizeBy: none

	column anio
		dataType: int64
		formatString: 0
		sourceColumn: anio
		summarizeBy: none

	column trimestre
		dataType: int64
		formatString: 0
		sourceColumn: trimestre
		summarizeBy: none

	column mes
		dataType: int64
		formatString: 0
		sourceColumn: mes
		summarizeBy: none

	column nombre_mes
		dataType: string
		sourceColumn: nombre_mes
		sortByColumn: mes
		summarizeBy: none

	column semana_iso
		dataType: int64
		formatString: 0
		sourceColumn: semana_iso
		summarizeBy: none

	column dia
		dataType: int64
		formatString: 0
		sourceColumn: dia
		summarizeBy: none

	column dia_semana
		dataType: int64
		formatString: 0
		sourceColumn: dia_semana
		summarizeBy: none

	column nombre_dia
		dataType: string
		sourceColumn: nombre_dia
		sortByColumn: dia_semana
		summarizeBy: none

	column es_fin_semana
		dataType: boolean
		sourceColumn: es_fin_semana
		summarizeBy: none

	column anio_mes
		dataType: string
		sourceColumn: anio_mes
		summarizeBy: none

	hierarchy Calendario
		level Anio
			column: anio
		level Trimestre
			column: trimestre
		level Mes
			column: nombre_mes
		level Dia
			column: dia

	partition dim_fecha = m
		mode: import
		source =
			let
			    Origen = PostgreSQL.Database(Servidor, BaseDatos),
			    Tabla = Origen{[Schema = "dw", Item = "dim_fecha"]}[Data],
			    Tipos = Table.TransformColumnTypes(Tabla, {{"fecha_key", Int64.Type}, {"fecha", type date}, {"anio", Int64.Type}, {"trimestre", Int64.Type}, {"mes", Int64.Type}, {"nombre_mes", type text}, {"semana_iso", Int64.Type}, {"dia", Int64.Type}, {"dia_semana", Int64.Type}, {"nombre_dia", type text}, {"es_fin_semana", type logical}, {"anio_mes", type text}})
			in
			    Tipos
