# Copia este archivo como .env y pon tus propios valores.
# El archivo .env NO se sube a GitHub.

# PostgreSQL
POSTGRES_DB=bi_vinilos
POSTGRES_USER=bi_user
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_PORT=5432

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=cambia_esta_clave
GRAFANA_PORT=3000

# Usuario de solo lectura para Grafana y Power BI (solo ve el esquema dw)
BI_LECTOR_USER=bi_lector
BI_LECTOR_PASSWORD=cambia_esta_clave
