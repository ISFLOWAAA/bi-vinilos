# --- Credenciales (NUNCA se suben) ---
.env
*.env
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# --- Datos generados por el ETL (se reconstruyen desde cero) ---
data/staging/
data/processed/
*.log

# --- Power BI (formato PBIP: se versiona el proyecto, no la caché) ---
*.pbix
**/.pbi/localSettings.json
**/.pbi/cache.abf

# --- Docker (volúmenes locales) ---
pgdata/
grafana-data/

# --- Sistema / editores ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
~$*

# --- Pruebas ---
.pytest_cache/

# --- Simulacion: bandera local para provocar una falla en la demo ---
simulacion/falla.flag

# --- Hoja personal con credenciales y configuracion del equipo (NUNCA se sube) ---
privado/

# --- Informe resumido: se versionan el generador y las figuras; el .docx/.pdf generados se suben solo cuando se aprueban ---
docs/informe/*_resumido.docx
docs/informe/*_resumido.pdf
